{
    "name": "dept-of-scrapyard-robotics/st77xx",
    "description": "Drive ST7735, ST7789 and ST7796 colour TFT displays over SPI with the ScrapyardIO GPIO framework.",
    "type": "library",
    "version": "0.8.0",
    "keywords": [
        "st7735",
        "st7789",
        "st7796",
        "tft",
        "display",
        "spi",
        "scrapyard-io"
    ],
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "gpio/contracts": "^0.8.0",
        "gpio/integrated-circuits": "^0.8.0",
        "gpio/nuts-and-bolts": "^0.8.0",
        "surface/contracts": "^0.8.0",
        "venusian-voyager/nuts-and-bolts": "^0.8.0"
    },
    "require-dev": {
        "gpio/digital": "^0.8.0",
        "gpio/spi": "^0.8.0",
        "pestphp/pest": "^4",
        "venusian-voyager/config": "^0.8.0",
        "venusian-voyager/vessel": "^0.8.0"
    },
    "suggest": {
        "gpio/digital": "^0.8.0 - DC and RST pins for ST77xxSPITransport",
        "gpio/spi": "^0.8.0 - SPI connections for ST77xxSPITransport",
        "microscrap/scrapyard-linux": "^0.8.0 - native spidev and libgpiod drivers",
        "microscrap/scrapyard-usb": "^0.8.0 - MPSSE SPI and pins over FTDI"
    },
    "autoload": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Displays\\ST77xx\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Displays\\ST77xx\\Tests\\": "tests/"
        },
        "files": [
            "tests/Support/helpers.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.8.x-dev"
        },
        "venusian": {
            "providers": [
                "DeptOfScrapyardRobotics\\Displays\\ST77xx\\Providers\\ST77xxServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "/Volumes/ProjectSaturnStudios/Development/PHP/ProjectSaturnStudios/dev/scrapyard-io/framework/src/GeneralPurposeIO/*",
            "options": {
                "symlink": true,
                "versions": {
                    "gpio/contracts": "0.8.0",
                    "gpio/digital": "0.8.0",
                    "gpio/i2c": "0.8.0",
                    "gpio/integrated-circuits": "0.8.0",
                    "gpio/nuts-and-bolts": "0.8.0",
                    "gpio/pwm": "0.8.0",
                    "gpio/spi": "0.8.0",
                    "gpio/uart": "0.8.0"
                }
            }
        },
        {
            "type": "path",
            "url": "/Volumes/ProjectSaturnStudios/Development/PHP/ProjectSaturnStudios/dev/venusian/framework/src/Voyager/*",
            "options": {
                "symlink": true,
                "versions": {
                    "venusian-voyager/collections": "0.8.8",
                    "venusian-voyager/conditionable": "0.8.8",
                    "venusian-voyager/config": "0.8.8",
                    "venusian-voyager/contracts": "0.8.8",
                    "venusian-voyager/io-pools": "0.8.8",
                    "venusian-voyager/macroable": "0.8.8",
                    "venusian-voyager/magic-aliases": "0.8.8",
                    "venusian-voyager/nuts-and-bolts": "0.8.8",
                    "venusian-voyager/reflection": "0.8.8",
                    "venusian-voyager/vessel": "0.8.8"
                }
            }
        },
        {
            "type": "path",
            "url": "/Volumes/ProjectSaturnStudios/Development/PHP/ProjectSaturnStudios/dev/venusian/surface/src/Surface/Contracts",
            "options": {
                "symlink": true,
                "versions": {
                    "surface/contracts": "0.8.0"
                }
            }
        }
    ]
}
