{
    "name": "dept-of-scrapyard-robotics/st77xx",
    "description": "Drive ST7735, ST7789 and ST7796 colour TFT displays over SPI with the ScrapyardIO GPIO framework.",
    "type": "library",
    "version": "0.10.0",
    "keywords": [
        "st7735",
        "st7789",
        "st7796",
        "tft",
        "display",
        "spi",
        "scrapyard-io"
    ],
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "gpio/contracts": "^0.10.0",
        "gpio/integrated-circuits": "^0.10.0",
        "gpio/nuts-and-bolts": "^0.10.0",
        "venusian-surface/contracts": "^0.10.0",
        "venusian-voyager/nuts-and-bolts": "^0.10.0",
        "venusian-voyager/vessel": "^0.10.0"
    },
    "require-dev": {
        "gpio/digital": "^0.10.0",
        "gpio/spi": "^0.10.0",
        "pestphp/pest": "^4",
        "venusian-voyager/config": "^0.10.0"
    },
    "suggest": {
        "gpio/digital": "^0.10.0 - DC and RST pins for ST77xxSPITransport",
        "gpio/spi": "^0.10.0 - SPI connections for ST77xxSPITransport",
        "microscrap/scrapyard-linux": "^0.10.0 - native spidev and libgpiod drivers",
        "microscrap/scrapyard-usb": "^0.10.0 - MPSSE SPI and pins over FTDI"
    },
    "autoload": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Displays\\ST77xx\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Displays\\ST77xx\\Tests\\": "tests/"
        },
        "files": [
            "tests/Support/helpers.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "providers": [
                "DeptOfScrapyardRobotics\\Displays\\ST77xx\\Providers\\ST77xxServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
